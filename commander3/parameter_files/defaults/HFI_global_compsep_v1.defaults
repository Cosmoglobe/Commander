
##############################################################
#                     Model parameters                       #
##############################################################	

CG_CONVERGENCE_CRITERION       = fixed_iter   # {residual,chisquare}
CG_MINITER                     =     5
CG_TOLERANCE                   = 1.d-31   # Fractional CG convergence criterion
CG_CONV_CHECK_FREQUENCY        =     1   # Check convergence every n'th iteration
CG_PRECOND_TYPE                = diagonal  #{pseudoinv}

NUM_SMOOTHING_SCALES           = 1

#fullsky spec. ind. parameters sampling (per say no smoothing in skymaps, but smoothing in postproc)
SMOOTHING_SCALE_FWHM01          = 60.      # Arcmin; 0 = native resolution
SMOOTHING_SCALE_LMAX01          = 768
SMOOTHING_SCALE_NSIDE01         = 256  # Must match NSIDE of component it is used for
SMOOTHING_SCALE_PIXWIN01        = common/pixwind/pixel_window_n0256.fits
SMOOTHING_SCALE_FWHM_POSTPROC01 = 30.    # Smoothing FWHM after pixel-by-pixel fit

# Alm sampler settings
ALMSAMP_NSAMP_ALM                      = 100
ALMSAMP_BURN_IN                        = 2     
ALMSAMP_NSIDE_CHISQ_LOWRES             = 512
ALMSAMP_PRIOR_FWHM                     = 0
ALMSAMP_OPTIMIZE_ALM                   = .false. 
ALMSAMP_APPLY_PRIOR                    = .true. 
ALMSAMP_PIXREG                         = .true.
ALMSAMP_PRIORSAMP_FROZEN_REGIONS       = .true.

INSTRUMENT_PARAM_FILE         = /mn/stornext/u3/hke/data_hfi/data/init_instpar_hfi_v1.dat
INIT_INSTRUMENT_FROM_HDF      = none 
 
EXTINCTION_E(B-V)_MAP = none

NUM_SIGNAL_COMPONENTS         = 16
INCLUDE_COMP01                = .true.  # Cmb # CMB; no monopole or dipole
INCLUDE_COMP02                = .true.  # md # Mono and dipoles
INCLUDE_COMP03                = .true.  # Cold dust # HI correlated dust
INCLUDE_COMP04                = .true.  # Hot dust # CII correlated dust
INCLUDE_COMP05                = .true.  # WHAM Halpha correlated dust in absorption
INCLUDE_COMP06                = .true.  # nearby dust #hotPAH dust
INCLUDE_COMP07                = .true.  # freefree
INCLUDE_COMP08                = .true.  # CMB relativistic quadrupole
INCLUDE_COMP09                = .false.  # CO10
INCLUDE_COMP10                = .false.  # CO21
INCLUDE_COMP11                = .false.  # CO32
INCLUDE_COMP12                = .false.  # Polarized synchrotron (DR1)
INCLUDE_COMP13                = .false.  # Polarized dust (DR1)
INCLUDE_COMP14                = .true. # Sync
INCLUDE_COMP15                = .false. # Radio
INCLUDE_COMP16                = .true. # AME

NUM_CG_SAMPLING_GROUPS = 0

@START 01
CG_SAMPLING_GROUP&&          = cmb,dust,dust_cii
CG_SAMPLING_GROUP_MASK&&     = fullsky
CG_SAMPLING_GROUP_MAXITER&&  = 70
CG_SAMPLING_GROUP_BANDS&&    = 023-WMAP_K,030-WMAP_Ka,040-WMAP_Q1,040-WMAP_Q2,060-WMAP_V1,060-WMAP_V2,090-WMAP_W1,090-WMAP_W2,090-WMAP_W3,090-WMAP_W4,030,044,070,100,143,217,353,545,857,0.4-Haslam
@END 01

@START 02
CG_SAMPLING_GROUP&&          = synch
CG_SAMPLING_GROUP_MASK&&     = fullsky
CG_SAMPLING_GROUP_MAXITER&&  = 70
CG_SAMPLING_GROUP_BANDS&&    = 023-WMAP_K,030-WMAP_Ka,040-WMAP_Q1,040-WMAP_Q2,060-WMAP_V1,060-WMAP_V2,090-WMAP_W1,090-WMAP_W2,090-WMAP_W3,090-WMAP_W4,030,044,070,100,143,217,353,545,857,0.4-Haslam
@END 02


@START 03
CG_SAMPLING_GROUP&&          = ame
CG_SAMPLING_GROUP_MASK&&     = fullsky
CG_SAMPLING_GROUP_MAXITER&&  = 70
CG_SAMPLING_GROUP_BANDS&&    = 023-WMAP_K,030-WMAP_Ka,040-WMAP_Q1,040-WMAP_Q2,060-WMAP_V1,060-WMAP_V2,090-WMAP_W1,090-WMAP_W2,090-WMAP_W3,090-WMAP_W4,030,044,070
@END 03



# CMB #RS yes
@START 01
@DEFAULT components/cmb/cmb_HFI.defaults
COMP_AMP_INPUT_MAP&&          = /mn/stornext/u3/hke/data_hfi/COM_CMB_IQU-commander_2048_R3.00_full_inpaint_dipole.fits
COMP_INIT_FROM_HDF&&          = none default
COMP_APPLY_DUST_EXTINCTION&&  = .false.
COMP_MONOPOLE_PRIOR&&         = monopole-dipole:common/mask/mask_common_dx12_n2048_TQU.fits
@END 01

# Mono- and dipole component for non-FIRAS bands #RS yes
@START 02
@DEFAULT components/monodipole/md_HFI.defaults
COMP_MD_DEFINITION_FILE&&     = /mn/stornext/u3/hke/data_hfi/data/init_md_hfi_v1.dat
COMP_INIT_FROM_HDF&&          = default
COMP_APPLY_DUST_EXTINCTION&&  = .false.
@END 02

# Thermal dust component #RS yes #DONT USE TABS< ONYL SPACES ALLOWED!
@START 03
@DEFAULT components/dust/dust_HI_cold_HFI_n4096_pol.defaults
COMP_LABEL&&                  = dust
COMP_TYPE&&                   = MBBtab
COMP_MBBTAB_TYPE&&            = spline_log
COMP_SED_TEMPLATE&&           = init_comm3/common/init_sed_cold_dust.dat
COMP_NU_REF_T&&               = 545
COMP_T_DEFAULT&&              = 11.3
COMP_BETA_DEFAULT&&           = 1.50
COMP_AMP_INPUT_MAP&&          = none /mn/stornext/d22/cmbco_nobackup/raelynsu/grid_tests/grid_300000000/dust_c0001_k000002.fits
COMP_MONOPOLE_PRIOR&&         = crosscorr:hi4pi/maps/HI4PI_NHI_n0064_60arcmin_rescaled_TQU.fits,64,60.d0,1.5,2.0,2.5,3.0,3.5,4.0  #<corr-map name>,<nside>,<FWHM>,<threshold(s)>
COMP_BETA_INPUT_MAP&&         = none
COMP_T_INPUT_MAP&&            = none
COMP_AMP_PRIOR_MAP&&          = none
COMP_INDMASK&&                = fullsky
COMP_APPLY_DUST_EXTINCTION&&  = .false.
@DEFAULT components/dust/dust_DIRBE_localsampler.defaults
COMP_INIT_FROM_HDF&&          = default
@END 03

# CII-correlated thermal dust component #RS yes
@START 04
@DEFAULT components/dust/dust_cii_hot_HFI_n4096.defaults
COMP_LABEL&&                  = dust_cii
COMP_TYPE&&                   = MBBtab
COMP_MBBTAB_TYPE&&            = spline_log
COMP_SED_TEMPLATE&&           = init_comm3/common/init_sed_hot_dust.dat
COMP_NU_REF_T&&               = 545
COMP_T_DEFAULT&&              = 30.0
COMP_BETA_DEFAULT&&           = 1.75
COMP_AMP_INPUT_MAP&&          = /mn/stornext/d22/cmbco_nobackup/raelynsu/grid_tests/grid_300000000/dust_cii_c0001_k000002.fits
COMP_BETA_INPUT_MAP&&         = none
COMP_T_INPUT_MAP&&            = none 
COMP_AMP_PRIOR_MAP&&          = none 
COMP_INDMASK&&                = fullsky 
COMP_APPLY_DUST_EXTINCTION&&  = .false.
COMP_MONOPOLE_PRIOR&&         = crosscorr:hi4pi/maps/HI4PI_NHI_n0064_60arcmin_rescaled_TQU.fits,64,60.d0,1.5,2.0,2.5,3.0,3.5,4.0  #<corr-map name>,<nside>,<FWHM>,<threshold(s)>
@DEFAULT components/dust/dust_hotPAH_localsampler.defaults
COMP_INIT_FROM_HDF&&          = default
@END 04

# WHAM Halpha correlated dust in absorption #RS yes
@START 05
@DEFAULT components/dust/dust_Ha_ext_HFI_n2048.defaults
COMP_LABEL&&                  = dust_Ha
COMP_TYPE&&                   = MBBtab
COMP_MBBTAB_TYPE&&            = spline_log
COMP_SED_TEMPLATE&&           = init_comm3/common/init_sed_Ha_dust.dat
COMP_T_DEFAULT&&              = 17.8
COMP_BETA_DEFAULT&&           = 2.62
COMP_AMP_INPUT_MAP&&          = /mn/stornext/d22/cmbco_nobackup/raelynsu/grid_tests/grid_300000000/dust_Ha_c0001_k000002.fits
COMP_NU_REF_T&&               = 545
COMP_BETA_INPUT_MAP&&         = none 
COMP_T_INPUT_MAP&&            = none 
COMP_INDMASK&&                = common/mask/mask_DIRBE_colddust_n2048_v2.fits
COMP_MONOPOLE_PRIOR&&         = crosscorr:hi4pi/maps/HI4PI_NHI_n0064_60arcmin_rescaled_TQU.fits,64,60.d0,1.5,2.0,2.5,3.0,3.5,4.0  #<corr-map name>,<nside>,<FWHM>,<threshold(s)>
COMP_APPLY_DUST_EXTINCTION&&  = .false.
@DEFAULT components/dust/dust_hotPAH_localsampler.defaults
COMP_INIT_FROM_HDF&&          = default
@END 05


# Hot dust + PAH #RS yes, nearby dust
@START 06
@DEFAULT components/dust/dust_near_HFI_n2048.defaults
COMP_LABEL&&                  = dust_nearby
COMP_TYPE&&                   = MBBtab
COMP_MBBTAB_TYPE&&            = spline_log
COMP_SED_TEMPLATE&&           = init_comm3/common/init_sed_nearby_dust.dat
COMP_NU_REF_T&&               = 545
COMP_AMP_PRIOR_MAP&&          = edenhofer/init_edenhofer_545_uKrj_n2048_v1.fits
COMP_T_DEFAULT&&              = 18.0
COMP_BETA_DEFAULT&&           = 1.7
COMP_AMP_INPUT_MAP&& = /mn/stornext/d22/cmbco_nobackup/raelynsu/grid_tests/grid_300000000/hotPAH_c0001_k000002.fits
COMP_BETA_INPUT_MAP&&         = none
COMP_T_INPUT_MAP&&            = none   
COMP_INDMASK&&                = common/mask/mask_DIRBE_hotdust_n2048_v2.fits
COMP_MONOPOLE_PRIOR&&         = crosscorr:hi4pi/maps/HI4PI_NHI_n0064_60arcmin_rescaled_TQU.fits,64,60.d0,1.5,2.0,2.5,3.0,3.5,4.0  #<corr-map name>,<nside>,<FWHM>,<threshold(s)>
COMP_APPLY_DUST_EXTINCTION&&  = .false.
@DEFAULT components/dust/dust_hotPAH_localsampler.defaults
COMP_INIT_FROM_HDF&&          = default
@END 06



# Polarized synchrotron component
@START 12
@DEFAULT components/synch/synch_LFI.defaults
COMP_LABEL&&                  = polsynch
COMP_AMP_INPUT_MAP&&          = /mn/stornext/u3/hke/data_hfi/data/init_polsynch_amp_DR1_QU_v1.fits
COMP_BETA_INPUT_MAP&&         = default 
COMP_OUTPUT_FWHM&&            = 40
# New Local sampling parameters
@DEFAULT components/synch/synch_LFI_localsampler.defaults
COMP_BETA_SMOOTHING_SCALE&&   = 0
COMP_CG_SAMP_GROUP_MAXITER&&  = 50
COMP_INDMASK&&                = fullsky 
COMP_BETA_MASK&&              = fullsky 
COMP_INIT_FROM_HDF&&          = none 
COMP_BETA_POL_LMAX&&          = -1
COMP_BETA_INT_PRIOR_MEAN&&    = -3.15
COMP_BETA_INT_PRIOR_RMS&&     =  0.05
COMP_BETA_POL_PRIOR_MEAN&&    = -3.15
COMP_BETA_POL_PRIOR_RMS&&     =  0.05
#COMP_BETA_PRIOR_GAUSS_MEAN&&  =  -3.1
#COMP_BETA_PRIOR_GAUSS_RMS&&   =   0.03
COMP_BETA_DEFAULT&&           = -3.2
COMP_BETA_COMBINED_MONOPOLE_SAMPLING&& = .false.
@END 12


# Thermal dust component
@START 13
@DEFAULT components/dust/dust_LFI.defaults
COMP_LABEL&&                  = poldust
COMP_NU_REF_T&&               = 857
COMP_NU_REF_P&&               = 353
COMP_INDMASK&&                = fullsky
COMP_AMP_INPUT_MAP&&          = /mn/stornext/u3/hke/data_hfi/data/init_poldust_amp_DR1_QU_v1_x5.fits
COMP_BETA_INPUT_MAP&&         = default
COMP_T_INPUT_MAP&&            = default
COMP_BETA_SMOOTHING_SCALE&&   = 0
COMP_AMP_LMAX&&               = 2000
@DEFAULT components/dust/dust_LFI_localsampler.defaults
# New Local sampling parameters, 'dust'
COMP_MONOPOLE_PRIOR&&         = crosscorr:hi4pi/maps/HI4PI_NHI_n0064_60arcmin_rescaled_TQU.fits,64,60.d0,1.5,2.0,2.5,3.0,3.5,4.0  #<corr-map name>,<nside>,<FWHM>,<threshold(s)>
COMP_IND_LMAX&&               = 0
COMP_BETA_DEFAULT&&           = 1.50
COMP_T_DEFAULT&&              = 19.5
COMP_BETA_COMBINED_MONOPOLE_SAMPLING&& = .false.
COMP_BETA_ALMSAMP_INIT&&      = none
COMP_BETA_MASK&&              = fullsky
COMP_BETA_INT_LNLTYPE&&       = prior 
COMP_BETA_INT_LMAX&&          = -1
COMP_BETA_INT_PIXREG&&        = pixreg
COMP_BETA_POL_LNLTYPE&&       = prior
COMP_BETA_INT_PRIOR_MEAN&&    = 1.50
COMP_BETA_POL_PRIOR_MEAN&&    = 1.50
COMP_BETA_POL_PRIOR_RMS&&     = 0.03 0.03
COMP_BETA_INT_PRIOR_RMS&&     = 0.03 
COMP_BETA_POL_LMAX&&          = -1
COMP_INIT_FROM_HDF&&          = none 
@END 13

# Synchrotron component
@START 14
@DEFAULT components/synch/synch_LFI.defaults
COMP_AMP_INPUT_MAP&&          = common/maps/CG_synch_amp_v4.fits
COMP_BETA_INPUT_MAP&&         = common/maps/CG_synch_beta_v4.fits
COMP_OUTPUT_FWHM&&            = 40
# New Local sampling parameters
@DEFAULT components/synch/synch_LFI_localsampler.defaults
COMP_CG_SAMP_GROUP_MAXITER&&  = 50
COMP_INDMASK&&                = common/mask/mask_synch_beta_sampling_BP10_n1024_TQU.fits
COMP_BETA_MASK&&              = common/mask/mask_synch_beta_sampling_BP10_n1024_TQU.fits
COMP_INIT_FROM_HDF&&          = default
COMP_BETA_POL_LMAX&&          = -1
COMP_BETA_POL_LNLTYPE&&       = prior
COMP_BETA_POL_FIX_PIXREG&&    = 1
COMP_BETA_SMOOTHING_SCALE&&   = 1
COMP_BETA_POL_PIXREG_PRIOR&&  = '-3.1,-3.1,-3.1,-3.1,'
COMP_BETA_ALMSAMP_INIT&&      = init_comm3/common/init_alm_synch_beta_CG_v3.dat
COMP_PRIOR_GAUSS_BETA_MEAN&&  = -3.1
COMP_BETA_INT_PRIOR_MEAN&&    = -3.15
COMP_BETA_INT_PRIOR_RMS&&     =  0.05
COMP_BETA_POL_PRIOR_MEAN&&    = -3.15
COMP_BETA_POL_PRIOR_RMS&&     =  0.05
COMP_BETA_PRIOR_GAUSS_MEAN&&  =  -3.1
COMP_BETA_PRIOR_GAUSS_RMS&&   =   0.03
COMP_BETA_DEFAULT&&           = -3.2
COMP_BETA_COMBINED_MONOPOLE_SAMPLING&& = .false.
@END 14


# Radio sources
@START 15
@DEFAULT components/radio/radio_LFI.defaults
COMP_CATALOG&&                 = NVSS/COM_AT20G_GB6_NVSS_PCCS2_nothreshold_v8.dat
COMP_INIT_CATALOG&&            = init_comm3/common/init_radio_BP8.11.dat
COMP_OUTPUT_PTSRC_TEMPLATE&&   = .false.  # set to true the first time for new data sets, generates file named in COMP_PTSRC_TEMPLATE
COMP_PTSRC_TEMPLATE&&          = NVSS/COM_AT20G_GB6_NVSS_PCCS2_nothreshold_hfilfiwmap_v4.h5
COMP_INIT_FROM_HDF&&           = none
COMP_APPLY_DUST_EXTINCTION&&  = .false.
@END 15
# Radio sources


# Low-frequency AME component ------------------------------------------------------------------
@START 16
@DEFAULT components/ame/ame_CG_exp.defaults
COMP_AMP_INPUT_MAP&&          = common/maps/CG_ame_amp_v4.fits
COMP_BETA_INPUT_MAP&&         = common/maps/CG_ame_beta_v4.fits
@DEFAULT components/ame/ame_CG_exp_localsampler.defaults
# New Local sampling parameters, 'ame'
COMP_BETA_INT_LMAX&&          = -1
COMP_BETA_INT_PIXREG&&        = pixreg
COMP_BETA_INT_LNLTYPE&&       = prior
COMP_BETA_POL_LNLTYPE&&       = prior
COMP_BETA_INT_PRIOR_MEAN&&    = -3.57
COMP_BETA_INT_PRIOR_RMS&&     = 0.1
COMP_BETA_COMBINED_MONOPOLE_SAMPLING&& = .false.
COMP_INDMASK&&                = common/mask/mask_ame_nup_CG_v1.fits
COMP_INIT_FROM_HDF&&          = default
COMP_BETA_DEFAULT&&           = -3.4
COMP_BETA_ALMSAMP_INIT&&      = init_comm3/common/init_alm_ame_beta_CG_v1.dat
COMP_CL_DEFAULT_AMP_T&&       = 1e4
@END 16

NUM_MCMC_SAMPLING_GROUPS = 0


@START 01
MCMC_SAMPLING_GROUP_PARAMS&&            = dust:T%0.005,dust_cii:T%0.005,dust_nearby:T%0.005,dust_Ha:T%0.005,dust:beta%0.001,dust_cii:beta%0.001,dust_nearby:beta%0.001,dust_Ha:beta%0.001
MCMC_SAMPLING_GROUP_UPDATE_CG_GROUPS&&  = none 1,2,3
MCMC_SAMPLING_GROUP_CHISQ_BANDS&&       = 060-WMAP_V1,060-WMAP_V2,090-WMAP_W1,090-WMAP_W2,090-WMAP_W3,090-WMAP_W4,030,044,070,100,143,217,353,545,857
MCMC_SAMPLING_GROUP_CHISQ_MASK&&        = /mn/stornext/u3/hke/data_hfi/data/mask_hfi_chisq10k_v1.fits common/mask/mask_fullsky_n0512_TQU.fits 
MCMC_SAMPLING_GROUP_NUMSTEP&&           = 30
@END 01

@START 02
MCMC_SAMPLING_GROUP_PARAMS&&            = ame:beta%0.01
MCMC_SAMPLING_GROUP_UPDATE_CG_GROUPS&&  = none 1,2,3
MCMC_SAMPLING_GROUP_CHISQ_BANDS&&       = 023-WMAP_K,030-WMAP_Ka,040-WMAP_Q1,040-WMAP_Q2,060-WMAP_V1,060-WMAP_V2,090-WMAP_W1,090-WMAP_W2,090-WMAP_W3,090-WMAP_W4,030,044,070
MCMC_SAMPLING_GROUP_CHISQ_MASK&&        = /mn/stornext/u3/hke/data_hfi/data/mask_hfi_chisq10k_v1.fits
MCMC_SAMPLING_GROUP_NUMSTEP&&           = 30
@END 02

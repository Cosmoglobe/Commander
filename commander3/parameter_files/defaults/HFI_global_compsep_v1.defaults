# freefree component ---------------------------------------------------------------------
@START 07
@DEFAULT components/freefree/freefree_LFI.defaults
COMP_AMP_INPUT_MAP&&          = /mn/stornext/u3/hke/data_hfi/data/COM_CompMap_freefree-commander_1024_R2.00_amp1.fits
#COMP_AMP_INPUT_MAP&&          = /mn/stornext/d22/cmbco_nobackup/hke/chains_chipass_init166/ff_c0001_k000012.fits
COMP_AMP_LMAX&&               = 1000  #2000 2955
COMP_APOD_LMAX&&              = 1000  #2000 2955
COMP_T_E_DEFAULT&&            = 5000.
COMP_CL_TYPE&&                = gauss  # {none, single_l, binned,power_law, exp}
COMP_CL_DEFAULT_AMP_T&&       = 100          # D_l = amp * (l/lpivot)**beta
COMP_CL_DEFAULT_BETA_T&&      = 30.d0 # smoothing scale
COMP_OUTPUT_FWHM&&            = 30         # arcmin

#COMP_CL_TYPE&&                = power_law_gauss  # {none, single_l, binned,power_law, ex#p}
#COMP_CL_POLTYPE&&             = 2  # {1 = {T+E+B}, 2 = {T,E+B}, 3 = {T,E,B}}
#COMP_CL_BETA_PRIOR_MEAN&&     = -0.0
#COMP_CL_BETA_PRIOR_RMS&&      = 0.0
#COMP_CL_L_PIVOT&&             = 50  1          # Pivot multipole
#COMP_CL_DEFAULT_AMP_T&&       = 10          # D_l = amp * (l/lpivot)**beta
#COMP_CL_DEFAULT_BETA_T&&      = 1.0d0 
#COMP_CL_DEFAULT_THETA_T&&     = 30.d0 # equivalent to BETA for CL_TYPE = gauss (see synch), BP8.0 used 90.d0

COMP_MONOPOLE_PRIOR&&         = monopole:common/mask/mask_ff_monoprior_bp10_n1024_TQU.fits
COMP_AMP_PRIOR_MAP&&          = none
COMP_EM_INPUT_MAP&&           = /mn/stornext/u3/hke/data_hfi/data/COM_CompMap_freefree-commander_1024_R2.00_EM_1deg.fits
COMP_T_E_INPUT_MAP&&          = /mn/stornext/u3/hke/data_hfi/data/COM_CompMap_freefree-commander_1024_R2.00_Te.fits
@DEFAULT components/freefree/freefree_LFI_localsampler.defaults
COMP_INIT_FROM_HDF&&          = none
COMP_APPLY_DUST_EXTINCTION&& = .false.
@END 07


# CMB relativistic quadrupole correction #RS yes
@START 08
@DEFAULT components/cmb/cmb_relquad2.defaults
@END 08

# CO10 line emission #RS yes
@START 09

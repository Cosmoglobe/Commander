# CHIPASS 1.4 GHz
BAND_LABEL&&&                  = 1.4-CHIPASS
BAND_INSTRUMENT_LABEL&&&       = 1.4-CHIPASS
BAND_POLARIZATION&&&           = .false.
BAND_OBS_PERIOD&&&             = 1
BAND_NSIDE&&&                  = 1024
BAND_LMAX&&&                   = 2955
BAND_UNIT&&&                   = mK_cmb #MJy/sr # NOTE: actual unit is Jy beam^-1
BAND_NOISE_FORMAT&&&           = rms
BAND_MAPFILE&&&                = /mn/stornext/d16/personal/daniersp/data/lambda_chipass_healpix_r10.fits
BAND_NOISEFILE&&&              = /mn/stornext/d16/personal/daniersp/data/CHIPASS_rms_n1024_mK_constant.fits 
BAND_REG_NOISEFILE&&&          = none 
BAND_NOISE_RMS&&&_SMOOTH01     = none 
BAND_NOISE_RMS&&&_SMOOTH02     = none 
BAND_NOISE_RMS&&&_SMOOTH03     = none 
BAND_NOISE_UNIFORMIZE_FSKY&&&  = 0.00
BAND_MASKFILE&&&               = /mn/stornext/d16/personal/daniersp/data/mask_file_lambda_chipass_healpix_r10.fits 
BAND_MASKFILE_CALIB&&&         = /mn/stornext/d16/personal/daniersp/data/mask_file_lambda_chipass_healpix_r10.fits 
BAND_BEAMTYPE&&&               = b_l         # {b_l, febecop}
BAND_BEAM_B_L_FILE&&&          = /mn/stornext/d16/cmbco/AST9240/2022/data/processed_maps/AST9240__1395_MHz_Chipass_nside1024_fwhm0.24deg_lmax2955_beam.fits # the gaussian beam
BAND_BEAM_B_PTSRC_FILE&&&      = none 
BAND_PIXEL_WINDOW&&&           = common/pixwind/pixel_window_n1024.fits
BAND_SAMP_NOISE_AMP&&&         = .false.
BAND_BANDPASS_TYPE&&&          = delta
BAND_BANDPASS_MODEL&&&         = additive_shift   # {powlaw_tilt, additive_shift}
BAND_NOMINAL_FREQ&&&           = 1.395
BAND_SAMP_BANDPASS&&&          = .false.
BAND_BANDPASSFILE&&&           = haslam_bp.dat
BAND_SAMP_GAIN&&&              = .false.
BAND_GAIN_PRIOR_MEAN&&&         = 1.
BAND_GAIN_PRIOR_RMS&&&          = 0.
BAND_GAIN_CALIB_COMP&&&        = 2
BAND_GAIN_LMIN&&&              = -1
BAND_GAIN_LMAX&&&              = -1
BAND_GAIN_APOD_MASK&&&         = fullsky
BAND_GAIN_APOD_FWHM&&&         = 120.
BAND_DEFAULT_GAIN&&&           =   1.
BAND_DEFAULT_BP_DELTA&&&       =   0.
BAND_DEFAULT_NOISEAMP&&&       =   1.
BAND_COMPONENT_SENSITIVITY&&& = broadband

# CHIPASS TOD defaults
BAND_TOD_TYPE&&&               = CHIPASS

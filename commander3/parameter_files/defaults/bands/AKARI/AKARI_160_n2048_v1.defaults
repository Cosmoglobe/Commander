# AKARI 160 default parameters

@DEFAULT bands/AKARI/AKARI_160_v1.defaults
BAND_NSIDE&&&                  = 2048
BAND_LMAX&&&                   = 4100
BAND_PIXEL_WINDOW&&&           = common/pixwind/pixel_window_n2048.fits

BAND_TOD_FLAG&&&               = 2097149   # Apply all flags

BAND_MAPFILE&&&                = akari/maps/akari_160_1_2048.fits
BAND_NOISEFILE&&&              = akari/rms/akari_160_temprms_2048.fits

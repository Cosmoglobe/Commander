# AKARI 160 default parameters

@DEFAULT bands/AKARI/AKARI_160_v1.defaults
BAND_NSIDE&&&                  = 8192
BAND_LMAX&&&                   = 24000
BAND_PIXEL_WINDOW&&&           = common/pixwind/pixel_window_n8192.fits

BAND_TOD_FLAG&&&               = 2147483647   # Apply all flags

BAND_MAPFILE&&&                = akari/maps/akari_160_1_8192.fits
BAND_NOISEFILE&&&              = akari/rms/akari_160_temprms_8192.fits
